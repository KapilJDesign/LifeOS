# Copy to .env.local (never commit real keys). Everything here is optional:
# with no values the app runs fully offline on the deterministic mock processor.
#
# WARNING: VITE_-prefixed variables are bundled into client code and visible to anyone
# who can load the app. Use a browser-side key for local demos only. In production the
# key stays on the server and the app calls the backend (see LifeOS-Architecture.md).

# "llm" turns on the LLM provider for processing and chat answers. Default: mock.
VITE_AI_PROVIDER=mock

# Any OpenAI-compatible chat-completions endpoint.
VITE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_LLM_MODEL=gpt-4o-mini
VITE_LLM_API_KEY=
